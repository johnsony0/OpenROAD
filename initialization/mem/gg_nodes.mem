// gg_nodes.mem -- 280280 words x 32 bits (8 hex digits per line)
// grid-graph nodes, addr = (z*154 + y)*182 + x
//
//   [31:28]  scratchpad         4b  spare, 0 here -- RTL-owned, no meaning to this script
//   [27:25]  prevAstarNodeDir   3b  frDirEnum, 0 = UNKNOWN (A* scratch, 0 here)
//   [24]     closed             1b  A* scratch, 0 here
//   [23:0]   node state        24b  one bit each, see below
//
//   state from ggs_iter1_x50400_y50400_s3.bin (search 3: 3626 guide, 1 src, 8 dst)
//
//   node state bits, LSB first:
//
//   bit  0  hasEastEdge
//   bit  1  hasNorthEdge
//   bit  2  hasUpEdge
//   bit  3  isBlockedEast
//   bit  4  isBlockedNorth
//   bit  5  isBlockedUp
//   bit  6  hasSpecialVia
//   bit  7  overrideShapeCostVia
//   bit  8  hasGridCostEast
//   bit  9  hasGridCostNorth
//   bit 10  hasGridCostUp
//   bit 11  hasApCostEast
//   bit 12  hasApCostNorth
//   bit 13  hasApCostUp
//   bit 14  routeShapeCostPlanar != 0
//   bit 15  routeShapeCostVia != 0
//   bit 16  markerCostPlanar != 0
//   bit 17  markerCostVia != 0
//   bit 18  fixedShapeCostVia != 0
//   bit 19  fixedShapeCostPlanarHorz != 0
//   bit 20  fixedShapeCostPlanarVert != 0
//   bit 21  guide
//   bit 22  src
//   bit 23  dst
//
//   prevAstarNodeDir is frDirEnum: 0=UNKNOWN, 1=D, 2=S, 3=W, 4=E, 5=N, 6=U
//
// load with $readmemh
